// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @map("_id")
  name        String?
  avatar      String?
  bank        Float     @default(0)
  wallet      Float     @default(10000000)
  lastDaily   DateTime?
  lastWork    DateTime?
  lastRob     DateTime?
  lastCrime   DateTime?
  inventory   Json      @default("{}")
  investments Json      @default("{}") // { "BTC": 0.05, "GOTO": 100 }
  dailyStreak Int       @default(0)
  xp          Int       @default(0)
  level       Int       @default(1)
  scPity      Int       @default(0)
  gachaConfig Json?
  lastGachaTime DateTime?
  gachaStreak   Int       @default(0)
  createdAt   DateTime  @default(now())
  warnings    Warning[]
}

model Bounty {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  targetId  String   @unique
  reward    Float
  placedBy  String
  createdAt DateTime @default(now())
}

model MarketAsset {
  id           String   @id @map("_id") // e.g. BTC, GOTO, BBCA
  name         String
  type         String   // stock | crypto
  price        Float
  lastPrice    Float    @default(0)
  volatility   Float    @default(0.05) // Max % move per tick
  priceHistory Float[]  @default([])   // Last 20-50 price points
  updatedAt    DateTime @default(now())
}

model Warning {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String
  moderatorId String
  reason      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model Giveaway {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId     String
  channelId   String
  messageId   String   @unique
  hostId      String
  prize       String
  winnersCount Int
  endsAt      DateTime
  ended       Boolean  @default(false)
  participants String[] @default([])
  winners     String[] @default([])
  createdAt   DateTime @default(now())
}

model GuildConfig {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId          String   @unique
  welcomeChannelId String?
  leaveChannelId   String?
  welcomeMessage   String?  @default("Selamat datang {user} di {server}!")
  leaveMessage     String?  @default("{user} baru aja cabut dari {server}. Sedih banget.")
  gachaConfig     Json?
  updatedAt        DateTime @default(now()) @updatedAt
}

model BattleRoom {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  roomCode     String   @unique
  hostId       String
  hostName     String
  hostAvatar   String?
  guildId      String
  caseType     String   // budget, classic, highroller, elite, sultan
  crateCount   Int      @default(1)
  maxPlayers   Int      @default(2)
  isPrivate    Boolean  @default(false)
  crazyMode    Boolean  @default(false)
  isTeamMode   Boolean  @default(false)
  status       String   @default("waiting") // waiting, running, finished
  participants Json     @default("[]") // [{id, name, avatar, ready}]
  spectators   Json     @default("[]") // [{id, name}]
  results      Json?    // [{participantId, skins[], totalValue}]
  winnerId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model Developer {
  id        String   @id @map("_id")
  name      String?
  addedAt   DateTime @default(now())
}

model SuitRoom {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  roomCode     String   @unique
  hostId       String
  hostName     String
  hostAvatar   String?
  guildId      String
  bet          Float    @default(0)
  status       String   @default("waiting") // waiting, running, revealed, finished
  participants Json     @default("[]") // [{id, name, avatar, ready, choice}]
  spectators   Json     @default("[]") // [{id, name}]
  winnerId     String?
  isPrivate    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model TypingRoom {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  roomCode     String   @unique
  hostId       String
  hostName     String
  hostAvatar   String?
  guildId      String
  bet          Float    @default(0)
  targetText   String?
  status       String   @default("waiting") // waiting, running, finished
  participants Json     @default("[]") // [{id, name, avatar, ready, progress, wpm}]
  winnerId     String?
  isPrivate    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}
