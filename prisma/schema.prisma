generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = "mongodb+srv://JoshuaRVL:09071982@jbot.zmry4kd.mongodb.net/jbot?appName=jbot"
}

model User {
  id          String    @id @map("_id")
  name        String?
  avatar      String?
  bank        Float     @default(0)
  wallet      Float     @default(100000)
  lastDaily   DateTime?
  lastWork    DateTime?
  lastRob     DateTime?
  lastCrime   DateTime?
  inventory   Json      @default("{}")
  investments Json      @default("{}") // { "BTC": 0.05, "GOTO": 100 }
  dailyStreak Int       @default(0)
  xp          Int       @default(0)
  level       Int       @default(1)
  createdAt   DateTime  @default(now())
  warnings    Warning[]
}

model Bounty {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  targetId  String   @unique
  reward    Float
  placedBy  String
  createdAt DateTime @default(now())
}

model MarketAsset {
  id           String   @id @map("_id") // e.g. BTC, GOTO, BBCA
  name         String
  type         String   // stock | crypto
  price        Float
  lastPrice    Float    @default(0)
  volatility   Float    @default(0.05) // Max % move per tick
  priceHistory Float[]  @default([])   // Last 20-50 price points
  updatedAt    DateTime @default(now())
}

model Warning {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String
  moderatorId String
  reason      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model Giveaway {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId     String
  channelId   String
  messageId   String   @unique
  hostId      String
  prize       String
  winnersCount Int
  endsAt      DateTime
  ended       Boolean  @default(false)
  participants String[] @default([])
  winners     String[] @default([])
  createdAt   DateTime @default(now())
}

model GuildConfig {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId          String   @unique
  welcomeChannelId String?
  leaveChannelId   String?
  welcomeMessage   String?  @default("Selamat datang {user} di {server}!")
  leaveMessage     String?  @default("{user} baru aja cabut dari {server}. Sedih banget.")
  updatedAt        DateTime @default(now()) @updatedAt
}
